# ── Secrets and store identity — NEVER commit ────────────────────────────
.env
.env.*
!.env.example
*.token
*.pem
*.key
.shopify/
shopify.theme.toml
.shopify-cli.yml
.credentials.json

# ── Dependencies / build ─────────────────────────────────────────────────
node_modules/
.npm/
*.log
npm-debug.log*

# ── Test output ──────────────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/
.playwright/
tests/__screenshots__/actual/

# Generated by tests/build-harness.mjs on every run (globalSetup). Build output, not source —
# committing it would let a stale copy drift away from the theme it is supposed to mirror.
tests/harness/

# Generated by tests/build-preview.mjs. Build output, not source — regenerate with
# `npm run preview:build`.
tests/preview/
tests/tmp/

# ── OS noise ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
