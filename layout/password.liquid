<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background | default: '#F7F8F5' }}">

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {% render 'theme-tokens' %}

    {{ 'critical.css' | asset_url | stylesheet_tag }}

    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <a class="skip-link" href="#main-content">{{ 'general.accessibility.skip_to_content' | t }}</a>

    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
