# Italian Tech Atelier — local development only.
# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#
# These are used ONLY by the optional product-import utility (docs/product-import-guide.md).
# The theme itself needs none of them; the storefront never reads environment variables.

# Your development store domain, e.g. my-dev-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Admin API access token for a CUSTOM APP scoped to the minimum required:
#   read_products, write_products, read_metaobjects, write_metaobjects,
#   read_metaobject_definitions, write_metaobject_definitions
# Never use a token with order, customer or payment scopes for imports.
SHOPIFY_ADMIN_API_TOKEN=

# Admin API version, e.g. 2026-07
SHOPIFY_API_VERSION=
