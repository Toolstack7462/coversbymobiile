{% comment %}
  Password reset.
{% endcomment %}

<div class="account page">
  <div class="account__panel surface">
    <div class="account__form-block">
      <h1 class="text-h2">{{ 'customers.recover.title' | t }}</h1>

      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="account__message account__message--error" role="alert">
            <p class="text-ui">{{ 'forms.error_generic' | t }}</p>
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="reset-password">{{ 'customers.login.password' | t }}</label>
          <input class="input" id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>

        <div class="field">
          <label class="field__label" for="reset-password-confirm">
            {{- 'customers.login.password' | t -}}
          </label>
          <input class="input" id="reset-password-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>

        <button class="button button--primary button--full" type="submit">
          {{ 'general.actions.save' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reimposta password",
  "settings": []
}
{% endschema %}
