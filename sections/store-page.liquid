{% comment %}
  The physical store page (/pages/negozio).

  Everything here is merchant-configured. Nothing is invented — not the hours, not the services,
  not the accessibility information. An unconfigured field is simply absent, because a wrong
  opening time or an unoffered service sends a real person on a wasted journey.

  MAP AND PRIVACY: the map is a static image until the customer explicitly loads it. Embedding a
  third-party map iframe on page load would set third-party cookies and contact an external
  service before consent, which is exactly what the consent banner exists to prevent.

  This template is also the source of truth for NAP consistency (name, address, phone) shared
  with the footer and the LocalBusiness structured data.
{% endcomment %}

{%- liquid
  assign has_store = false
  if settings.store_name != blank and settings.store_street != blank
    assign has_store = true
  endif

  assign services = section.blocks | where: 'type', 'service'
  assign faqs = section.blocks | where: 'type', 'faq'
  assign photos = section.blocks | where: 'type', 'photo'
-%}

<div class="storepage page">
  {% render 'breadcrumbs' %}

  {%- if has_store -%}
    <header class="storepage__header">
      <p class="eyebrow">{{ 'store.title' | t }}</p>
      <h1 class="text-h1">{{ settings.store_name }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="text-body text-secondary text-measure">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <div class="storepage__layout">
      <div class="storepage__main">
        {%- if photos.size > 0 -%}
          {%- assign eager_used = false -%}
          <ul class="storepage__gallery" role="list" aria-label="{{ 'store.gallery' | t }}">
            {%- for block in photos -%}
              {%- if block.settings.image != blank -%}
                <li {{ block.shopify_attributes }}>
                  <div class="media media--cover">
                    <img
                      src="{{ block.settings.image | image_url: width: 900 }}"
                      srcset="
                        {{ block.settings.image | image_url: width: 450 }} 450w,
                        {{ block.settings.image | image_url: width: 900 }} 900w
                      "
                      sizes="(min-width: 990px) 45vw, 90vw"
                      alt="{{ block.settings.image.alt | default: settings.store_name | escape }}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      {% if eager_used == false %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                    >
                    {%- assign eager_used = true -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if services.size > 0 -%}
          <section class="storepage__section">
            <h2 class="text-h2">{{ 'store.services' | t }}</h2>
            <ul class="storepage__services" role="list">
              {%- for block in services -%}
                {%- if block.settings.heading != blank -%}
                  <li class="storepage__service" {{ block.shopify_attributes }}>
                    {% render 'icon', name: block.settings.icon, class: 'icon--lg' %}
                    <div>
                      <h3 class="text-ui storepage__service-title">{{ block.settings.heading }}</h3>
                      {%- if block.settings.body != blank -%}
                        <p class="text-ui text-secondary">{{ block.settings.body }}</p>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

        <section class="storepage__section">
          <h2 class="text-h2">{{ 'pickup.how_it_works' | t }}</h2>
          <div class="rte text-body text-secondary text-measure">
            {%- if section.settings.pickup_explanation != blank -%}
              {{ section.settings.pickup_explanation }}
            {%- else -%}
              <p>{{ 'pickup.select_at_checkout' | t }}</p>
            {%- endif -%}
          </div>
        </section>

        {%- if settings.store_accessibility != blank or settings.store_parking != blank -%}
          <section class="storepage__section">
            <div class="storepage__info-grid">
              {%- if settings.store_accessibility != blank -%}
                <div>
                  <h2 class="text-h3">{{ 'store.accessibility' | t }}</h2>
                  <p class="text-ui text-secondary">{{ settings.store_accessibility | newline_to_br }}</p>
                </div>
              {%- endif -%}
              {%- if settings.store_parking != blank -%}
                <div>
                  <h2 class="text-h3">{{ 'store.parking' | t }}</h2>
                  <p class="text-ui text-secondary">{{ settings.store_parking | newline_to_br }}</p>
                </div>
              {%- endif -%}
            </div>
          </section>
        {%- endif -%}

        {%- if faqs.size > 0 -%}
          <section class="storepage__section">
            <h2 class="text-h2">{{ 'store.faq' | t }}</h2>
            {%- for block in faqs -%}
              {%- if block.settings.question != blank -%}
                <details class="accordion" {{ block.shopify_attributes }}>
                  <summary class="accordion__summary">
                    <span class="text-ui storepage__faq-q">{{ block.settings.question }}</span>
                    {% render 'icon', name: 'chevron-down', class: 'accordion__chevron' %}
                  </summary>
                  <div class="accordion__body rte text-measure">{{ block.settings.answer }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </section>
        {%- endif -%}
      </div>

      <aside class="storepage__aside">
        <div class="storepage__card surface">
          <h2 class="text-h3">{{ 'store.address' | t }}</h2>

          <address class="storepage__address text-body">
            <strong>{{ settings.store_name }}</strong><br>
            {{ settings.store_street }}<br>
            {{ settings.store_postcode }} {{ settings.store_city }}
            {%- if settings.store_province != blank %} ({{ settings.store_province }}){% endif %}<br>
            Italia
          </address>

          {%- if settings.store_hours_display != blank -%}
            <div class="storepage__block">
              <h3 class="eyebrow">{{ 'store.hours' | t }}</h3>
              <p class="text-ui">{{ settings.store_hours_display | newline_to_br }}</p>
            </div>
          {%- endif -%}

          <ul class="storepage__contact" role="list">
            {%- if settings.business_phone != blank -%}
              <li>
                <a class="storepage__contact-link" href="tel:{{ settings.business_phone | remove: ' ' }}">
                  {% render 'icon', name: 'phone', class: 'icon--sm' %}
                  {{ settings.business_phone }}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.business_whatsapp != blank -%}
              <li>
                <a class="storepage__contact-link" href="https://wa.me/{{ settings.business_whatsapp }}" rel="noopener" target="_blank">
                  {% render 'icon', name: 'whatsapp', class: 'icon--sm' %}
                  {{ 'store.contact_whatsapp' | t }}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.business_email != blank -%}
              <li>
                <a class="storepage__contact-link" href="mailto:{{ settings.business_email }}">
                  {% render 'icon', name: 'mail', class: 'icon--sm' %}
                  {{ settings.business_email }}
                </a>
              </li>
            {%- endif -%}
          </ul>

          {%- if settings.store_directions_url != blank -%}
            <a class="button button--primary button--full" href="{{ settings.store_directions_url }}" rel="noopener" target="_blank">
              {% render 'icon', name: 'map-pin', class: 'icon--sm' %}
              {{ 'store.directions' | t }}
            </a>
          {%- endif -%}
        </div>

        {%- if settings.store_map_image != blank or settings.store_map_embed_url != blank -%}
          <store-map
            class="storepage__map"
            data-embed-url="{{ settings.store_map_embed_url | escape }}"
            data-title="{{ 'store.map_title' | t | escape }}"
          >
            <div class="storepage__map-preview" data-map-preview>
              {%- if settings.store_map_image != blank -%}
                <div class="media media--cover">
                  <img
                    src="{{ settings.store_map_image | image_url: width: 800 }}"
                    srcset="
                      {{ settings.store_map_image | image_url: width: 400 }} 400w,
                      {{ settings.store_map_image | image_url: width: 800 }} 800w,
                      {{ settings.store_map_image | image_url: width: 1200 }} 1200w
                    "
                    sizes="(min-width: 990px) 340px, 90vw"
                    alt="{{ 'store.map_title' | t | escape }}"
                    width="{{ settings.store_map_image.width }}"
                    height="{{ settings.store_map_image.height }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}

              {%- if settings.store_map_embed_url != blank -%}
                <div class="storepage__map-consent">
                  <p class="text-caption">{{ 'store.map_consent' | t }}</p>
                  <button class="button button--secondary button--small" type="button" data-map-load>
                    {{ 'store.map_load' | t }}
                  </button>
                </div>
              {%- endif -%}
            </div>
          </store-map>

          <script type="module" src="{{ 'store-map.js' | asset_url }}"></script>
        {%- endif -%}
      </aside>
    </div>
  {%- else -%}
    <div class="empty-state surface">
      {% render 'icon', name: 'store', class: 'icon--xl' %}
      <p class="empty-state__title text-h3">{{ 'store.not_configured' | t }}</p>
      <p class="text-ui text-secondary">{{ 'errors.missing_config_body' | t }}</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .storepage {
    padding-block: var(--space-5) var(--space-8);
  }

  .storepage__header {
    display: grid;
    gap: var(--space-2);
    margin-block-end: var(--space-6);
  }

  .storepage__header h1 {
    margin: 0;
  }

  .storepage__layout {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .storepage__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin-block-end: var(--space-6);
  }

  .storepage__gallery .media {
    --media-ratio: 4 / 3;
    border-radius: var(--radius-card);
    border: var(--border-width) solid var(--color-border);
  }

  .storepage__section + .storepage__section {
    margin-block-start: var(--space-7);
  }

  .storepage__section h2 {
    margin-block-end: var(--space-4);
  }

  .storepage__services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    list-style: none;
  }

  .storepage__service {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .storepage__service .icon {
    flex: none;
    color: var(--color-primary);
  }

  .storepage__service-title {
    margin: 0 0 2px;
    font-weight: var(--weight-semibold);
  }

  .storepage__info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
  }

  .storepage__info-grid h2 {
    margin-block-end: var(--space-2);
  }

  .storepage__faq-q {
    font-weight: var(--weight-semibold);
  }

  .storepage__card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .storepage__card h2 {
    margin: 0;
  }

  .storepage__address {
    font-style: normal;
    margin: 0;
  }

  .storepage__block h3 {
    margin-block-end: var(--space-1);
  }

  .storepage__block p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .storepage__contact {
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }

  .storepage__contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    color: var(--color-ink);
    text-decoration: none;
  }

  .storepage__contact-link:hover {
    text-decoration: underline;
  }

  .storepage__map {
    display: block;
    margin-block-start: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .storepage__map-preview {
    position: relative;
  }

  .storepage__map .media {
    --media-ratio: 4 / 3;
  }

  .storepage__map-consent {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    padding: var(--space-3);
    background-color: var(--color-surface);
    border-block-start: var(--border-width) solid var(--color-border);
    text-align: center;
  }

  .storepage__map iframe {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0;
  }

  @media (min-width: 990px) {
    .storepage__layout {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: var(--space-7);
    }

    .storepage__aside {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-4));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.store_page",
  "settings": [
    { "type": "richtext", "id": "intro", "label": "t:labels.body" },
    {
      "type": "richtext",
      "id": "pickup_explanation",
      "label": "Come funziona il ritiro",
      "info": "Spiega solo il processo realmente in uso nel negozio."
    },
    {
      "type": "paragraph",
      "content": "Indirizzo, orari, telefono e mappa provengono dalle impostazioni del tema, cosi da restare identici in tutto il sito e nei dati strutturati."
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Servizio",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading" },
        { "type": "text", "id": "body", "label": "t:labels.body" },
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "default": "store",
          "options": [
            { "value": "store", "label": "Negozio" },
            { "value": "shield-check", "label": "Applicazione vetro" },
            { "value": "settings", "label": "Assistenza" },
            { "value": "device", "label": "Configurazione" },
            { "value": "package", "label": "Ritiro ordini" },
            { "value": "zap", "label": "Ricarica" }
          ]
        }
      ]
    },
    {
      "type": "photo",
      "name": "Foto del negozio",
      "limit": 6,
      "settings": [{ "type": "image_picker", "id": "image", "label": "t:labels.image" }]
    },
    {
      "type": "faq",
      "name": "Domanda frequente",
      "settings": [
        { "type": "text", "id": "question", "label": "Domanda" },
        { "type": "richtext", "id": "answer", "label": "Risposta" }
      ]
    }
  ]
}
{% endschema %}
