{% comment %}
  Password page, shown while the store is not yet open to the public.
{% endcomment %}

<div class="passwordpage page">
  <div class="passwordpage__inner">
    {%- if settings.logo != blank -%}
      <img
        class="passwordpage__logo"
        src="{{ settings.logo | image_url: width: 320 }}"
        alt="{{ shop.name | escape }}"
        width="160"
        height="{{ 160 | divided_by: settings.logo.aspect_ratio }}"
        loading="eager"
      >
    {%- else -%}
      <p class="text-h2">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="text-h1">{%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ 'password.title' | t }}{%- endif -%}</h1>
    <p class="text-body text-secondary">{%- if section.settings.body != blank -%}{{ section.settings.body }}{%- else -%}{{ 'password.body' | t }}{%- endif -%}</p>

    {%- if settings.store_name != blank and settings.store_street != blank -%}
      <address class="passwordpage__address text-ui">
        <strong>{{ settings.store_name }}</strong><br>
        {{ settings.store_street }}, {{ settings.store_postcode }} {{ settings.store_city }}
      </address>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="account__message account__message--error text-ui" role="alert">
          {{ 'forms.error_generic' | t }}
        </p>
      {%- endif -%}

      <div class="passwordpage__row">
        <label class="visually-hidden" for="storefront-password">
          {{- 'password.password_label' | t -}}
        </label>
        <input
          class="input"
          id="storefront-password"
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="{{ 'password.password_label' | t }}"
          required
        >
        <button class="button button--primary" type="submit">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .passwordpage {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding-block: var(--space-8);
  }

  .passwordpage__inner {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    max-width: 480px;
  }

  .passwordpage__logo {
    width: 160px;
    height: auto;
    margin-block-end: var(--space-3);
  }

  .passwordpage h1 {
    margin: 0;
  }

  .passwordpage__address {
    font-style: normal;
    color: var(--color-text-secondary);
  }

  .passwordpage__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
    width: 100%;
  }

  .passwordpage__row .input {
    flex: 1;
    min-width: 200px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "text", "id": "body", "label": "t:labels.body" }
  ]
}
{% endschema %}
