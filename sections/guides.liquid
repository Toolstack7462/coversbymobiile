{% comment %}
  Buying guides on the homepage.

  Guides are how an accessory store earns trust before the sale: someone who does not know
  whether they need 20W or 65W is not ready to buy, and a good guide converts far better than a
  bigger discount badge.

  Pulls real articles from a merchant-selected blog. Renders nothing if the blog is empty, so
  the homepage never shows an empty editorial slot.
{% endcomment %}

{%- liquid
  assign target_blog = blogs[section.settings.blog]
  assign limit = section.settings.posts_to_show | default: 3
-%}

{%- if target_blog != blank and target_blog.articles.size > 0 -%}
  <section class="section">
    <div class="page">
      <header class="section-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="text-h2">{%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ 'blog.title' | t }}{%- endif -%}</h2>
        </div>

        <a class="section-head__link text-ui" href="{{ target_blog.url }}">
          {{ 'blog.all_articles' | t }}
          {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}
        </a>
      </header>

      <ul class="bloglist__grid" role="list">
        {%- for article in target_blog.articles limit: limit -%}
          <li>
            <a class="post" href="{{ article.url }}">
              {%- if article.image -%}
                <div class="media media--cover post__media">
                  <img
                    src="{{ article.image | image_url: width: 800 }}"
                    srcset="
                      {{ article.image | image_url: width: 400 }} 400w,
                      {{ article.image | image_url: width: 800 }} 800w
                    "
                    sizes="(min-width: 990px) 30vw, 90vw"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}

              <div class="post__body">
                <h3 class="post__title text-h3">{{ article.title }}</h3>
                {%- if article.excerpt_or_content != blank -%}
                  <p class="post__excerpt text-ui text-secondary">
                    {{- article.excerpt_or_content | strip_html | truncate: 120 -}}
                  </p>
                {%- endif -%}
                <span class="post__more text-ui">
                  {{ 'blog.read_more' | t }}
                  {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}
                </span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:names.guides",
  "tag": "section",
  "class": "guides-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "blog", "id": "blog", "label": "t:labels.blog" },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 3
    }
  ],
  "presets": [{ "name": "t:names.guides", "category": "t:categories.editorial" }]
}
{% endschema %}
