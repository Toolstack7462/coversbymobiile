{% comment %}
  Homepage hero.

  DELIBERATELY COMPACT. It does not fill the first screen: on mobile the customer must be able
  to reach the device finder or real products with one short scroll. A full-viewport hero on a
  commerce homepage pushes the catalogue below the fold and measurably costs conversions.

  The image is the LCP element on the homepage, so it is the single eager, high-priority image
  on the page, with a separate mobile crop and reserved dimensions.

  No autoplay video. No text baked into the image (it cannot be translated, cannot be read by a
  screen reader and reflows badly).
{% endcomment %}

<section class="hero{% if section.settings.layout == 'split' %} hero--split{% endif %}">
  <div class="hero__inner page">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading text-display">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="hero__body text-body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="button button--primary" href="{{ section.settings.link }}">
            {{ section.settings.link_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_link_label != blank and section.settings.secondary_link != blank -%}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_link_label }}
          </a>
        {%- endif -%}

        {%- comment -%}
          The third action is the physical shop. It only appears when the merchant has actually
          configured a store, so it can never point at a shop that does not exist.
        {%- endcomment -%}
        {%- if section.settings.tertiary_link_label != blank and settings.store_name != blank -%}
          <a class="hero__store text-ui" href="{{ section.settings.tertiary_link | default: '/pages/negozio' }}">
            {% render 'icon', name: 'store', class: 'icon--sm' %}
            {{ section.settings.tertiary_link_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.image != blank -%}
      <div class="hero__media">
        <div class="media media--cover">
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1800 }} 1800w
            "
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hero {
    background-color: var(--color-surface);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-5);
    /* Padding, not min-height. The hero is exactly as tall as its content needs. */
    padding-block: var(--space-6);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    justify-content: center;
    max-width: 46ch;
  }

  .hero__heading {
    margin: 0;
  }

  .hero__body {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  .hero__store {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    color: var(--color-ink);
    font-weight: var(--weight-medium);
  }

  .hero__media .media {
    --media-ratio: 4 / 3;
    border-radius: var(--radius-editorial);
    border: var(--border-width) solid var(--color-border);
  }

  @media (min-width: 990px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-7);
      padding-block: var(--space-7);
    }

    .hero--split .hero__media .media {
      --media-ratio: 5 / 4;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Accessori per il tuo smartphone. Online e nel nostro negozio."
    },
    {
      "type": "text",
      "id": "body",
      "label": "t:labels.body",
      "default": "Cover, vetri, caricatori, cavi, power bank e molto altro."
    },
    { "type": "header", "content": "t:groups.links" },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "Acquista ora" },
    { "type": "url", "id": "link", "label": "t:labels.link" },
    {
      "type": "text",
      "id": "secondary_link_label",
      "label": "t:labels.secondary_link_label",
      "default": "Trova il tuo dispositivo"
    },
    { "type": "url", "id": "secondary_link", "label": "t:labels.secondary_link" },
    {
      "type": "text",
      "id": "tertiary_link_label",
      "label": "t:labels.tertiary_link_label",
      "default": "Visita il negozio",
      "info": "Mostrato solo se hai configurato il negozio fisico nelle impostazioni del tema."
    },
    { "type": "url", "id": "tertiary_link", "label": "t:labels.tertiary_link" },
    { "type": "header", "content": "t:groups.media" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.lcp_image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout_direction",
      "default": "split",
      "options": [
        { "value": "split", "label": "Testo e immagine" },
        { "value": "text", "label": "Solo testo" }
      ]
    }
  ],
  "presets": [{ "name": "t:names.hero", "category": "t:categories.storefront" }]
}
{% endschema %}
