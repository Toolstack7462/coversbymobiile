{% comment %}
  A product row driven by a merchant-selected collection.

  One section serves every product row on the homepage — best sellers, new arrivals, offers —
  because they differ only in which collection they point at. Duplicating this three times with
  different names would be three places to fix the same bug.

  "Best sellers" is achieved by pointing this at a collection sorted by Shopify's own
  best-selling order. The theme never labels a product a bestseller on its own.
{% endcomment %}

{%- liquid
  assign target = collections[section.settings.collection]
  assign limit = section.settings.products_to_show | default: 8
-%}

<section class="section">
  <div class="page">
    <header class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="text-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <p class="text-ui text-secondary">{{ section.settings.body }}</p>
        {%- endif -%}
      </div>

      {%- if target != blank -%}
        <a class="section-head__link text-ui" href="{{ target.url }}">
          {{ 'general.actions.see_all' | t }}
          {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}
        </a>
      {%- endif -%}
    </header>

    {%- if target != blank and target.products.size > 0 -%}
      <ul class="grid grid--products" role="list">
        {%- for product in target.products limit: limit -%}
          <li>
            {% render 'product-card', product: product, show_vendor: section.settings.show_vendor, show_rating: section.settings.show_rating, show_swatches: section.settings.show_swatches, show_quick_add: section.settings.show_quick_add %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- comment -%}
        Onboarding state for the theme editor: tells the merchant exactly what to do instead of
        rendering an empty row or placeholder products that do not exist.
      {%- endcomment -%}
      <div class="empty-state surface">
        {% render 'icon', name: 'grid', class: 'icon--xl' %}
        <p class="empty-state__title text-h3">{{ 'errors.missing_config_title' | t }}</p>
        <p class="text-ui text-secondary">
          Seleziona una categoria nelle impostazioni della sezione.
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.featured_products",
  "tag": "section",
  "class": "featured-products-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Prodotti in evidenza" },
    { "type": "text", "id": "body", "label": "t:labels.body" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "label": "t:labels.products_to_show",
      "default": 8
    },
    { "type": "header", "content": "t:groups.products" },
    { "type": "checkbox", "id": "show_vendor", "label": "t:labels.show_vendor", "default": true },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:labels.show_rating",
      "default": true,
      "info": "t:info.reviews_app"
    },
    { "type": "checkbox", "id": "show_swatches", "label": "t:labels.show_swatches", "default": true },
    { "type": "checkbox", "id": "show_quick_add", "label": "t:labels.show_quick_add", "default": true }
  ],
  "presets": [
    { "name": "t:names.featured_products", "category": "t:categories.product" }
  ]
}
{% endschema %}
