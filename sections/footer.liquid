{% comment %}
  Global footer.

  Doubles as the store's NAP (name, address, phone) surface. Consistent NAP across the footer,
  the store page, structured data and Google Business Profile is what makes local SEO work, so
  every value here comes from the same theme settings the LocalBusiness schema reads.

  Nothing is invented: an unconfigured address, VAT number or phone renders nothing rather than
  a placeholder that could reach a real customer.
{% endcomment %}

{%- liquid
  assign menu_blocks = section.blocks | where: 'type', 'menu'
  assign has_store = false
  if settings.store_name != blank and settings.store_street != blank
    assign has_store = true
  endif
-%}

<footer class="footer">
  <div class="footer__main page">
    <div class="footer__brand">
      <a class="footer__logo" href="{{ routes.root_url }}">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: 320 }}"
            alt="{{ 'header.logo_home' | t: shop_name: shop.name | escape }}"
            width="160"
            height="{{ 160 | divided_by: settings.logo.aspect_ratio }}"
            loading="lazy"
          >
        {%- else -%}
          <span class="text-h3">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- if settings.tagline != blank -%}
        <p class="footer__tagline text-ui text-secondary">{{ settings.tagline }}</p>
      {%- endif -%}

      {%- if has_store -%}
        <address class="footer__address text-ui">
          <strong>{{ settings.store_name }}</strong><br>
          {{ settings.store_street }}<br>
          {{ settings.store_postcode }} {{ settings.store_city }}
          {%- if settings.store_province != blank %} ({{ settings.store_province }}){% endif %}<br>
          Italia
        </address>
      {%- endif -%}

      <ul class="footer__contact text-ui" role="list">
        {%- if settings.business_phone != blank -%}
          <li>
            <a href="tel:{{ settings.business_phone | remove: ' ' }}">
              {% render 'icon', name: 'phone', class: 'icon--sm' %}
              {{ settings.business_phone }}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.business_whatsapp != blank -%}
          <li>
            <a href="https://wa.me/{{ settings.business_whatsapp }}" rel="noopener" target="_blank">
              {% render 'icon', name: 'whatsapp', class: 'icon--sm' %}
              WhatsApp
            </a>
          </li>
        {%- endif -%}
        {%- if settings.business_email != blank -%}
          <li>
            <a href="mailto:{{ settings.business_email }}">
              {% render 'icon', name: 'mail', class: 'icon--sm' %}
              {{ settings.business_email }}
            </a>
          </li>
        {%- endif -%}
      </ul>
    </div>

    {%- for block in menu_blocks -%}
      {%- assign block_menu = linklists[block.settings.menu] -%}
      {%- if block_menu != blank and block_menu.links.size > 0 -%}
        <nav class="footer__column" aria-labelledby="footer-{{ block.id }}" {{ block.shopify_attributes }}>
          <h2 class="footer__heading text-ui" id="footer-{{ block.id }}">
            {{- block.settings.heading | default: block_menu.title -}}
          </h2>
          <ul class="footer__list" role="list">
            {%- for link in block_menu.links -%}
              <li><a class="footer__link text-ui" href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}

    <div class="footer__column footer__column--newsletter">
      <h2 class="footer__heading text-ui">{{ 'newsletter.title' | t }}</h2>
      <p class="text-ui text-secondary">{{ 'newsletter.body' | t }}</p>

      {%- form 'customer', class: 'footer__newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="footer-newsletter-email">
          {{- 'newsletter.email_label' | t -}}
        </label>
        <div class="footer__newsletter-row">
          <input
            class="input"
            id="footer-newsletter-email"
            type="email"
            name="contact[email]"
            placeholder="{{ 'newsletter.email_placeholder' | t }}"
            autocomplete="email"
            required
          >
          <button class="button button--primary" type="submit">{{ 'newsletter.submit' | t }}</button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="footer__newsletter-message text-ui" role="status">
              {% render 'icon', name: 'check-circle', class: 'icon--sm' %}
              {{ 'newsletter.success' | t }}
            </p>
        {%- elsif form.errors -%}
          <p class="footer__newsletter-message footer__newsletter-message--error text-ui" role="alert">
            {{- 'newsletter.error' | t -}}
          </p>
        {%- endif -%}

        {%- if settings.privacy_policy_page != blank -%}
          <p class="text-caption text-secondary">
            <a href="{{ settings.privacy_policy_page.url }}">{{ 'newsletter.privacy_note' | t }}</a>
          </p>
        {%- endif -%}
      {%- endform -%}

      {%- assign has_social = false -%}
      {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_youtube != blank -%}
        {%- assign has_social = true -%}
      {%- endif -%}

      {%- if has_social -%}
        <ul class="footer__social" role="list" aria-label="{{ 'footer.social' | t }}">
          {%- if settings.social_instagram != blank -%}
            <li><a class="icon-button" href="{{ settings.social_instagram }}" rel="me noopener" target="_blank">
              {% render 'icon', name: 'external' %}<span class="visually-hidden">Instagram</span>
            </a></li>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <li><a class="icon-button" href="{{ settings.social_facebook }}" rel="me noopener" target="_blank">
              {% render 'icon', name: 'external' %}<span class="visually-hidden">Facebook</span>
            </a></li>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <li><a class="icon-button" href="{{ settings.social_tiktok }}" rel="me noopener" target="_blank">
              {% render 'icon', name: 'external' %}<span class="visually-hidden">TikTok</span>
            </a></li>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <li><a class="icon-button" href="{{ settings.social_youtube }}" rel="me noopener" target="_blank">
              {% render 'icon', name: 'external' %}<span class="visually-hidden">YouTube</span>
            </a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="footer__legal">
    <div class="footer__legal-inner page">
      <p class="text-caption">
        {%- assign current_year = 'now' | date: '%Y' -%}
        {{ 'footer.copyright' | t: year: current_year, shop_name: shop.name }}
        {%- if settings.business_legal_name != blank %} — {{ settings.business_legal_name }}{% endif -%}
      </p>

      <p class="text-caption footer__legal-ids">
        {%- if settings.business_vat != blank -%}
          <span>{{ 'footer.vat' | t: vat: settings.business_vat }}</span>
        {%- endif -%}
        {%- if settings.business_registration != blank -%}
          <span>{{ 'footer.registration' | t: registration: settings.business_registration }}</span>
        {%- endif -%}
      </p>

      {%- if settings.enable_consent_banner -%}
        <button class="footer__consent text-caption" type="button" data-consent-reopen>
          {% render 'icon', name: 'settings', class: 'icon--sm' %}
          {{ 'consent.reopen' | t }}
        </button>
      {%- endif -%}
    </div>

    {%- comment -%}
      Payment icons come from Shopify's enabled payment methods, so the footer can never
      advertise a method the merchant does not actually accept.
    {%- endcomment -%}
    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payments page" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .footer {
    background-color: var(--color-ink);
    color: var(--color-surface);
    margin-block-start: var(--space-9);
  }

  .footer__main {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__logo {
    display: inline-flex;
    text-decoration: none;
    color: inherit;
  }

  .footer__logo img {
    /* The logo is designed for a light ground; on navy it is knocked back to white. */
    filter: brightness(0) invert(1);
    width: 160px;
    height: auto;
  }

  .footer__tagline,
  .footer__address {
    margin: 0;
    color: rgb(255 255 255 / 0.72);
    font-style: normal;
  }

  .footer__address strong {
    color: var(--color-surface);
  }

  .footer__contact {
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }

  .footer__contact a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    color: var(--color-surface);
    text-decoration: none;
  }

  .footer__contact a:hover {
    text-decoration: underline;
  }

  .footer__heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-ui);
    font-weight: var(--weight-heading);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .footer__list {
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: rgb(255 255 255 / 0.72);
    text-decoration: none;
  }

  .footer__link:hover {
    color: var(--color-surface);
    text-decoration: underline;
  }

  .footer__newsletter-row {
    display: flex;
    gap: var(--space-2);
    margin-block: var(--space-3);
  }

  .footer__newsletter-row .input {
    flex: 1;
    min-width: 0;
  }

  /* White, not lime: lime is reserved for device context. White on the navy footer
     measures 18.72:1, and the icon carries the state so it is never colour-alone. */
  .footer__newsletter-message {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-surface);
    font-weight: var(--weight-semibold);
  }

  .footer__newsletter-message--error {
    color: var(--color-surface);
    background-color: var(--color-danger);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-control);
  }

  .footer__social {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin-block-start: var(--space-4);
  }

  .footer__social .icon-button {
    color: var(--color-surface);
    border: var(--border-width) solid rgb(255 255 255 / 0.24);
  }

  .footer__social .icon-button:hover {
    background-color: rgb(255 255 255 / 0.08);
  }

  .footer__legal {
    border-block-start: var(--border-width) solid rgb(255 255 255 / 0.16);
    padding-block: var(--space-4);
    color: rgb(255 255 255 / 0.6);
  }

  .footer__legal-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .footer__legal p {
    margin: 0;
  }

  .footer__legal-ids {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer__consent {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    color: inherit;
    text-decoration: underline;
  }

  .footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-block-start: var(--space-3);
  }

  .footer__payment-icon {
    width: 38px;
    height: 24px;
  }

  @media (min-width: 750px) {
    .footer__main {
      grid-template-columns: 1.4fr repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .footer__main {
      grid-template-columns: 1.6fr repeat(3, 1fr) 1.4fr;
      gap: var(--space-7);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonna di collegamenti",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading" },
        { "type": "link_list", "id": "menu", "label": "t:labels.menu" }
      ]
    }
  ],
  "presets": [{ "name": "t:names.footer" }]
}
{% endschema %}
