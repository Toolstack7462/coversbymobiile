{% comment %}
  Related and complementary products, from Shopify's Product Recommendations API.

  Two distinct intents, and mixing them is a common mistake:
  - "related"       — alternatives to this product (other cases for the same phone)
  - "complementary" — things that go WITH it (the screen protector for that case)

  Complementary recommendations are merchant-curated in Shopify Search & Discovery, which is
  what makes them compatibility-aware. The theme deliberately does not invent cross-sells from
  popularity: recommending a popular charger that does not fit the customer's phone is worse
  than recommending nothing.

  Loaded lazily via the Section Rendering API so it costs nothing until it is near the viewport.
{% endcomment %}

{%- liquid
  assign limit = section.settings.products_to_show | default: 4
  assign intent = section.settings.intent | default: 'related'

  # `x | default: 'key' | t` would pass the merchant's own heading to `t`. Resolve the
  # fallback separately instead.
  assign heading = section.settings.heading
  if heading == blank
    if intent == 'complementary'
      assign heading = 'products.complementary' | t
    else
      assign heading = 'products.related' | t
    endif
  endif
-%}

<product-recommendations
  class="section"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ intent }}"
  data-intent="{{ intent }}"
>
  {%- if recommendations.performed -%}
    {%- if recommendations.products_count > 0 -%}
      <div class="page">
        <header class="section-head">
          <div>
            <h2 class="text-h2">{{ heading }}</h2>
          </div>
        </header>

        <ul class="grid grid--products" role="list">
          {%- for product in recommendations.products -%}
            <li>{% render 'product-card', product: product, show_quick_add: false %}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  {%- endif -%}
</product-recommendations>

<script type="module" src="{{ 'recommendations.js' | asset_url }}"></script>

{% schema %}
{
  "name": "t:names.product_recommendations",
  "tag": "section",
  "class": "recommendations-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    {
      "type": "select",
      "id": "intent",
      "label": "Tipo di suggerimento",
      "default": "related",
      "options": [
        { "value": "related", "label": "Prodotti correlati (alternative)" },
        { "value": "complementary", "label": "Prodotti complementari (da abbinare)" }
      ],
      "info": "I prodotti complementari si configurano nell'app Search & Discovery di Shopify. Abbinali sempre a prodotti realmente compatibili."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 4
    }
  ],
  "presets": [
    { "name": "t:names.product_recommendations", "category": "t:categories.product" }
  ]
}
{% endschema %}
