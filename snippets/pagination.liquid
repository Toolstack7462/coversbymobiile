{% doc %}
  Pagination, with an optional "load more" enhancement.

  Real numbered pagination is always rendered. "Load more" is an enhancement that appends the
  next page and pushes the new URL into history, so the customer can still bookmark, share and
  use the back button. There is no uncontrolled infinite scroll: it strands keyboard users
  before the footer and makes results impossible to return to.

  @param {object} paginate - The paginate object.
  @param {boolean} [show_load_more] - Render the load-more control. Defaults to false.

  @example
  {% render 'pagination', paginate: paginate, show_load_more: true %}
{% enddoc %}

<nav class="pagination" aria-label="{{ 'general.accessibility.pagination' | t }}">
  {%- if show_load_more and paginate.next -%}
    <button
      class="button button--secondary pagination__more"
      type="button"
      data-load-more
      data-next-url="{{ paginate.next.url }}"
    >
      {{ 'collections.load_more' | t }}
    </button>
  {%- endif -%}

  <ol class="pagination__list" role="list" data-pagination>
    {%- if paginate.previous -%}
      <li>
        <a class="pagination__link" href="{{ paginate.previous.url }}" rel="prev">
          {% render 'icon', name: 'chevron-left', class: 'icon--sm' %}
          <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
        </a>
      </li>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a class="pagination__link" href="{{ part.url }}">
            <span aria-hidden="true">{{ part.title }}</span>
            <span class="visually-hidden">
              {{- 'general.accessibility.page_number' | t: number: part.title -}}
            </span>
          </a>
        {%- elsif part.is_link == false and part.title == '&hellip;' -%}
          <span class="pagination__gap" aria-hidden="true">{{ part.title }}</span>
        {%- else -%}
          <span class="pagination__link pagination__link--current" aria-current="page">
            <span aria-hidden="true">{{ part.title }}</span>
            <span class="visually-hidden">
              {{- 'general.accessibility.current_page' | t: number: part.title -}}
            </span>
          </span>
        {%- endif -%}
      </li>
    {%- endfor -%}

    {%- if paginate.next -%}
      <li>
        <a class="pagination__link" href="{{ paginate.next.url }}" rel="next">
          {% render 'icon', name: 'chevron-right', class: 'icon--sm' %}
          <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
        </a>
      </li>
    {%- endif -%}
  </ol>
</nav>

{% stylesheet %}
  .pagination {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-7);
  }

  .pagination__more {
    min-width: 240px;
  }

  .pagination__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
  }

  .pagination__link {
    display: grid;
    place-items: center;
    min-width: var(--target-min);
    min-height: var(--target-min);
    padding-inline: var(--space-2);
    border-radius: var(--radius-control);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  a.pagination__link:hover {
    background-color: var(--color-surface-sunken);
  }

  .pagination__link--current {
    background-color: var(--color-ink);
    color: var(--color-surface);
  }

  .pagination__gap {
    padding-inline: var(--space-2);
    color: var(--color-text-secondary);
  }
{% endstylesheet %}
