{% doc %}
  Renders one icon from the theme's single SVG icon system.

  All icons share a 24x24 viewBox, a 1.6 stroke and round caps/joins, so they sit together
  optically without per-icon correction. Colour comes from `currentColor`.

  Icons are decorative by default (`aria-hidden`). When an icon is the only content of a control,
  the control itself must carry a visually-hidden label — never pass a label here.

  @param {string} name - Icon name. See the case list below.
  @param {string} [class] - Extra class names appended to `icon`.
  @param {number} [size] - Square size in px. Defaults to the CSS-controlled 20px.

  @example
  {% render 'icon', name: 'search' %}
  {% render 'icon', name: 'cart', class: 'icon--lg' %}
{% enddoc %}

{%- liquid
  assign classes = 'icon'
  if class != blank
    assign classes = classes | append: ' ' | append: class
  endif
-%}

<svg
  class="{{ classes }}"
  viewBox="0 0 24 24"
  {% if size %}
    width="{{ size }}"
    height="{{ size }}"
  {% endif %}
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>

    {%- when 'cart' -%}
      <path d="M3 4h2l2.2 10.4a2 2 0 0 0 2 1.6h7.4a2 2 0 0 0 2-1.55L20.5 8H6"></path>
      <circle cx="10" cy="20" r="1.2"></circle><circle cx="17" cy="20" r="1.2"></circle>

    {%- when 'account' -%}
      <circle cx="12" cy="8.5" r="3.5"></circle><path d="M5 20a7 7 0 0 1 14 0"></path>

    {%- when 'heart' -%}
      <path d="M12 20s-7-4.4-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.6-7 9-7 9Z"></path>

    {%- when 'heart-filled' -%}
      <path d="M12 20s-7-4.4-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.6-7 9-7 9Z" fill="currentColor"></path>

    {%- when 'close' -%}
      <path d="m6 6 12 12M18 6 6 18"></path>

    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"></path>

    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"></path>

    {%- when 'chevron-up' -%}
      <path d="m6 15 6-6 6 6"></path>

    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"></path>

    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6"></path>

    {%- when 'arrow-right' -%}
      <path d="M4 12h15M13 6l6 6-6 6"></path>

    {%- when 'arrow-left' -%}
      <path d="M20 12H5M11 6l-6 6 6 6"></path>

    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7"></path>

    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9"></circle><path d="m8.5 12.5 2.5 2.5 4.5-5"></path>

    {%- when 'alert-triangle' -%}
      <path d="M12 4.5 21 19.5H3L12 4.5Z"></path><path d="M12 10v4"></path><path d="M12 17h.01"></path>

    {%- when 'alert-circle' -%}
      <circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path>

    {%- when 'info' -%}
      <circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path>

    {%- when 'phone' -%}
      <path d="M6 3h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1L15 11.5 19 13v3a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 4 5.2 2 2 0 0 1 6 3Z"></path>

    {%- when 'whatsapp' -%}
      <path d="M4 20l1.2-3.6A7.6 7.6 0 1 1 8 19l-4 1Z"></path>
      <path d="M9.2 9.4c.3 1 1.2 2.7 2.6 3.6.9.6 1.6.7 2 .5l.7-.9 1.6.9c-.1.7-.6 1.2-1.3 1.3-1.6.2-4-1.2-5.4-3.3-.7-1-1-2-.9-2.7.1-.6.5-1 1.1-1.1l.9 1.4-.6.9-.7-.6"></path>

    {%- when 'mail' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="m3.5 7 8.5 6 8.5-6"></path>

    {%- when 'map-pin' -%}
      <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"></path><circle cx="12" cy="10" r="2.5"></circle>

    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5.2l3.2 1.9"></path>

    {%- when 'store' -%}
      <path d="M4 9.5V19a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9.5"></path>
      <path d="M3.2 9.5 5 4.5h14l1.8 5a3 3 0 0 1-5.6 1.4 3 3 0 0 1-5.4 0 3 3 0 0 1-5.6-1.4Z"></path>

    {%- when 'device' -%}
      <rect x="7" y="2.5" width="10" height="19" rx="2.2"></rect><path d="M10.8 18.6h2.4"></path>

    {%- when 'filter' -%}
      <path d="M4 6h16M7 12h10M10 18h4"></path>

    {%- when 'sort' -%}
      <path d="M7 5v14M7 19l-3-3M17 19V5M17 5l3 3"></path>

    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"></path>

    {%- when 'minus' -%}
      <path d="M5 12h14"></path>

    {%- when 'trash' -%}
      <path d="M4.5 7h15M9.5 7V5.5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1V7"></path>
      <path d="M6.5 7 7.4 19a1.5 1.5 0 0 0 1.5 1.4h6.2a1.5 1.5 0 0 0 1.5-1.4L17.5 7"></path>

    {%- when 'external' -%}
      <path d="M14 5h5v5"></path><path d="m19 5-8 8"></path>
      <path d="M18.5 14v4.5a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5V7A1.5 1.5 0 0 1 6 5.5h4.5"></path>

    {%- when 'truck' -%}
      <path d="M3 6.5h10V16H3z"></path><path d="M13 9.5h4l3 3V16h-7z"></path>
      <circle cx="7" cy="18" r="1.6"></circle><circle cx="17" cy="18" r="1.6"></circle>

    {%- when 'package' -%}
      <path d="m12 3 8 4.2v9.6L12 21l-8-4.2V7.2L12 3Z"></path><path d="m4 7.2 8 4.3 8-4.3M12 11.5V21"></path>

    {%- when 'shield' -%}
      <path d="M12 3.5 19 6v5.5c0 4.2-2.9 7.4-7 8.9-4.1-1.5-7-4.7-7-8.9V6l7-2.5Z"></path>

    {%- when 'shield-check' -%}
      <path d="M12 3.5 19 6v5.5c0 4.2-2.9 7.4-7 8.9-4.1-1.5-7-4.7-7-8.9V6l7-2.5Z"></path>
      <path d="m9 12 2 2 4-4.5"></path>

    {%- when 'zap' -%}
      <path d="M13.5 3 5.5 13.5H11l-.5 7.5 8-10.5H13l.5-7.5Z"></path>

    {%- when 'battery' -%}
      <rect x="3" y="8" width="15" height="8" rx="2"></rect><path d="M21 11v2"></path><path d="M6 11v2"></path>

    {%- when 'plug' -%}
      <path d="M9 3v5M15 3v5"></path><path d="M6.5 8h11v3a5.5 5.5 0 0 1-11 0V8Z"></path><path d="M12 16.5V21"></path>

    {%- when 'cable' -%}
      <path d="M5 4v4a3 3 0 0 0 3 3h8a3 3 0 0 1 3 3v6"></path><path d="M3.5 4h3M17.5 20h3"></path>

    {%- when 'star' -%}
      <path d="m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L4.2 9.7l5.4-.8L12 4Z"></path>

    {%- when 'star-filled' -%}
      <path d="m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L4.2 9.7l5.4-.8L12 4Z" fill="currentColor"></path>

    {%- when 'grid' -%}
      <rect x="4" y="4" width="6.5" height="6.5" rx="1.4"></rect>
      <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.4"></rect>
      <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.4"></rect>
      <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.4"></rect>

    {%- when 'compare' -%}
      <path d="M12 4v16"></path><path d="M7 8H4l3 6 3-6H7Z"></path><path d="M17 8h-3l3 6 3-6h-3Z"></path>

    {%- when 'refresh' -%}
      <path d="M20 12a8 8 0 1 1-2.4-5.7"></path><path d="M20 4v4h-4"></path>

    {%- when 'settings' -%}
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6M18.4 18.4l-1.6-1.6M7.2 7.2 5.6 5.6"></path>

    {%- else -%}
      {%- comment -%}
        Unknown icon name. Render nothing rather than a placeholder glyph — a wrong icon is worse
        than no icon, and Theme Check cannot catch a typo in an icon name.
      {%- endcomment -%}
  {%- endcase -%}
</svg>

{% stylesheet %}
  .icon--sm {
    width: 1rem;
    height: 1rem;
  }

  .icon--lg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .icon--xl {
    width: 2rem;
    height: 2rem;
  }
{% endstylesheet %}
