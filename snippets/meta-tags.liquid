{% doc %}
  Renders title, description, canonical, robots and social metadata.

  Shopify already emits product structured data through `{{ product | structured_data }}`, so
  this snippet does NOT duplicate it — duplicated, conflicting schema is worse than none.
  Page-specific schema lives in `schema-*` snippets rendered by the relevant sections.

  @example
  {% render 'meta-tags' %}
{% enddoc %}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    when 'password'
      assign og_url = request.origin
  endcase
-%}

<title>
  {{ page_title }}
  {%- if current_tags %}{% assign tag_list = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tagged' | t: tags: tag_list }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

{%- if page_description != blank -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

<link rel="canonical" href="{{ canonical_url }}">

{%- comment -%}
  Filtered and sorted collection views are useful to shoppers but must not be indexed as
  duplicate pages. Shopify keeps the canonical on the unfiltered collection; this adds an
  explicit robots directive so the intent is unambiguous.
{%- endcomment -%}
{%- if request.page_type == 'collection' and current_tags == blank -%}
  {%- if request.query_string contains 'filter.' or request.query_string contains 'sort_by' -%}
    <meta name="robots" content="noindex, follow">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'search' -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  {%- if page_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ page_image.alt | escape }}">
  {%- endif -%}
{%- elsif settings.logo != blank -%}
  <meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
